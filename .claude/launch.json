{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "otopair-web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "otopair-before",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "../otopair-before", "run", "dev", "--", "--webpack", "-p", "3001"],
      "port": 3001
    },
    {
      "name": "otopair-web-prod",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "start"],
      "port": 3000,
      "autoPort": true
    }
  ]
}
